# ============================================================================
#  Sorare Bid Bot - Variables d'environnement (BACKEND uniquement)
# ----------------------------------------------------------------------------
#  Copier ce fichier vers `.env` a la racine puis remplir les valeurs.
#  Le `.env` NE DOIT JAMAIS etre commite (voir .gitignore).
#  Les secrets Sorare ne sont JAMAIS editables/affiches depuis le frontend.
# ============================================================================

# --- Reseau du serveur backend --------------------------------------------
# Par defaut on ecoute UNIQUEMENT sur localhost (usage local sans login).
# Pour un VPS, mettre 0.0.0.0 (et proteger l'acces par un reverse-proxy/firewall).
HOST=127.0.0.1
PORT=4000

# Origine autorisee pour le CORS frontend<->backend en dev local.
CORS_ORIGIN=http://localhost:5173

# --- Identifiants Sorare (SECRETS) -----------------------------------------
# Email et mot de passe EN CLAIR : le backend recupere le salt et hashe via bcrypt.
SORARE_EMAIL=your-email@example.com
SORARE_PASSWORD=your-plaintext-password

# `aud` du JWT : libre, reflete le nom de votre app (facilite le debug cote Sorare).
SORARE_JWT_AUD=sorare-bid-bot

# Cle API optionnelle (header APIKEY) : releve le rate limit de 60 -> 600 req/min.
# Laisser vide si vous n'en avez pas.
SORARE_API_KEY=

# --- Cle privee Starkware (SECRET CRITIQUE) --------------------------------
# OBLIGATOIRE uniquement pour ARMER les encheres REELLES.
# En mode dry-run (defaut), laisser VIDE : aucune signature, aucune enchere reelle.
# Exportable depuis sorare.com -> Wallet. Stockee EN MEMOIRE uniquement, jamais loggee.
SORARE_STARK_PRIVATE_KEY=

# --- Comportement du bot ----------------------------------------------------
# Mode simulation : true = aucune enchere reelle envoyee (recommande au demarrage).
# Meme si false, l'enchere reelle reste impossible sans SORARE_STARK_PRIVATE_KEY.
DRY_RUN=true

# Intervalle de polling des auctions, en millisecondes.
POLL_INTERVAL_MS=15000

# Endpoints Sorare (ne pas changer sauf raison precise).
SORARE_GRAPHQL_URL=https://api.sorare.com/graphql
SORARE_USERS_URL=https://api.sorare.com/api/v1/users

# Chemin du fichier SQLite (relatif a backend/, ou absolu).
DATABASE_PATH=./data/sorare-bot.sqlite

# Niveau de log : debug | info | warn | error
LOG_LEVEL=info
